# .env di compose per mcp-kanka. Copialo in .env e fai chmod 600 .env.

# Token API di Kanka e campagna, gli stessi del Mac
KANKA_TOKEN=
KANKA_CAMPAIGN_ID=1

# Dominio con cui Kanka CE registra le sue API (APP_DOMAIN nel kanka.env):
# il server lo manda come header Host parlando con http://kanka
KANKA_HOST_HEADER=

# Token del tunnel Cloudflare (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=

# Hostname privato del server MCP: lo stesso della rotta del tunnel
# e dell'URL registrato nel portal (http://<questo>:8000/mcp)
MCP_PRIVATE_HOSTNAME=

# Token condiviso fra portal e server MCP (Custom headers nel portal:
# Authorization: Bearer <questo>). Generalo con: openssl rand -hex 32
MCP_AUTH_TOKEN=
